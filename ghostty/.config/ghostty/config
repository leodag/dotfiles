# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
#
# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config.

theme = Selenized Light

font-family = Fira Mono
font-size = 10

shell-integration-features = no-cursor

unfocused-split-opacity = 1
focus-follows-mouse = true

notify-on-command-finish = unfocused
app-notifications = no-clipboard-copy

cursor-click-to-move = false

selection-foreground = cell-background
selection-background = cell-foreground

keybind = alt+down=goto_split:down
keybind = alt+up=goto_split:up
keybind = alt+right=goto_split:right
keybind = alt+left=goto_split:left

keybind = ctrl+alt+r=new_split:right
keybind = ctrl+alt+d=new_split:down

keybind = ctrl+shift+x=toggle_split_zoom

keybind = ctrl+equal=equalize_splits
